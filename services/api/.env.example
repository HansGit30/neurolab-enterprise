# ---- Local (sin Supabase): SQLite + usuarios de prueba por cabecera X-Dev-User
ENVIRONMENT=development
AUTH_MODE=dev
DATABASE_URL=sqlite:///./neurolab.db
CREATE_TABLES=true
CORS_ORIGINS=http://localhost:5173
EMBEDDED_WORKER=true

# ---- Producción (Render) — ver DEPLOY.md
# ENVIRONMENT=production
# AUTH_MODE=supabase
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service_role / secret key>   # solo servidor
# SUPABASE_JWT_SECRET=<legacy jwt secret, opcional>
# STORAGE_BUCKET=neurolab
# CORS_ORIGINS=https://<tu-app>.vercel.app
# EMBEDDED_WORKER=false
# WORKER_WAKE_URL=https://<usuario>-neurolab-worker.hf.space
